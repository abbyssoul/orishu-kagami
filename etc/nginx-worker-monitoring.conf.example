# Standalone nginx configuration, not an include in a general application proxy.
# Set the management IP, TLS files and loopback upstream for your deployment.
# Start with: nginx -e stderr -p /etc/orishu/monitoring/ -c nginx.conf
daemon off;
worker_processes 1;
pid nginx.pid;
error_log stderr warn;
events { worker_connections 64; }
http {
    access_log off;
    server_tokens off;
    client_header_timeout 5s;
    client_body_timeout 5s;
    send_timeout 5s;
    keepalive_timeout 5s;
    keepalive_requests 100;
    client_max_body_size 1k;
    large_client_header_buffers 2 4k;
    client_body_temp_path client_body;
    proxy_temp_path proxy_temp;
    fastcgi_temp_path fastcgi_temp;
    uwsgi_temp_path uwsgi_temp;
    scgi_temp_path scgi_temp;
    limit_conn_zone $server_name zone=monitoring:1m;

    # Inspect the original URI, not a normalized URI or arbitrary upstream URL.
    map $request_uri $monitoring_route {
        default 0;
        ~^/(metrics|livez|readyz|startupz)$ 1;
    }
    server {
        listen 192.0.2.10:9443 ssl;
        server_name worker-mgmt.example;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_certificate certs/server.crt;
        ssl_certificate_key certs/server.key;
        ssl_client_certificate certs/monitoring-ca.crt;
        ssl_verify_client on;
        ssl_verify_depth 1;
        ssl_session_tickets off;
        limit_conn monitoring 16;
        limit_conn_status 429;
        add_header Cache-Control no-store always;

        if ($monitoring_route = 0) { return 404; }
        if ($request_method != GET) { return 405; }
        location / {
            proxy_pass http://127.0.0.1:9168;
            proxy_http_version 1.1;
            proxy_pass_request_headers off;
            proxy_pass_request_body off;
            proxy_set_header Host localhost;
            proxy_set_header Connection close;
            proxy_set_header Content-Length "";
            proxy_connect_timeout 1s;
            proxy_read_timeout 5s;
            proxy_send_timeout 5s;
            proxy_buffer_size 4k;
            proxy_buffers 4 4k;
            proxy_max_temp_file_size 0;
            proxy_next_upstream off;
            proxy_hide_header Cache-Control;
        }
    }
}
